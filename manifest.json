{
  "manifest_version": 3,
  "name": "小说下载器",
  "version": "0.0.1",
  "description": "小说下载器",
  "author": "zwzw",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["jquery.js", "index.js"]
    }
  ],
  "web_accessible_resources": [],
  "host_permissions": [],
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  }
}
